# Optional. Copy these into your host's environment variables (Render/Railway/Fly).

# Lock the whole site with a passcode so only you two can join a room.
SITE_PASSWORD=

# Optional TURN relay, helps when one of you is on strict mobile data / office wifi.
# TURN_URL can be a comma separated list, e.g. turn:host:3478,turns:host:443?transport=tcp
TURN_URL=
TURN_USER=
TURN_PASS=
